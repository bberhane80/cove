<h1>
  List of all users
</h1>

<hr>

<article>
  <header>
    <h2>
      Add a new user
    </h2>
  </header>

  <form action="/insert_user" method="post">
    <div>
      <label for="email_box">
        Email
      </label>

      <input type="text" id="email_box" name="query_email">
    </div>

    <div>
      <label for="username_box">
        Username
      </label>

      <input type="text" id="username_box" name="query_username">
    </div>

    <div>
      <label for="password_box">
        Password
      </label>

      <input type="text" id="password_box" name="query_password">
    </div>

    <button type="submit">
      Create user
    </button>
  </form>
</article>

<hr>

<article>
  <ul>
    <% @list_of_users.each do |a_user| %>
      <li>
        <a href="/users/<%= a_user.id %>">
          User #<%= a_user.id %>
        </a>
      </li>
    <% end %>
  </ul>
</article>

<hr>
