<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      line-height: 1.6;
      color: #374151;
      background-color: #f9fafb;
      margin: 0;
      padding: 0;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
    }
    .header {
      background: linear-gradient(135deg, #2d5016 0%, #1b3409 100%);
      padding: 30px 20px;
      text-align: center;
      color: white;
    }
    .header h1 {
      margin: 0;
      font-size: 24px;
    }
    .content {
      padding: 30px 20px;
    }
    .greeting {
      font-size: 18px;
      margin-bottom: 20px;
      color: #1f2937;
    }
    .summary {
      background: #f0fdf4;
      border-left: 4px solid #2d5016;
      padding: 15px;
      margin: 20px 0;
      border-radius: 4px;
    }
    .listing-card {
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      margin: 20px 0;
      overflow: hidden;
    }
    .listing-image {
      width: 100%;
      height: 200px;
      object-fit: cover;
    }
    .listing-details {
      padding: 20px;
    }
    .listing-title {
      font-size: 20px;
      font-weight: 700;
      color: #1f2937;
      margin: 0 0 10px 0;
    }
    .listing-location {
      color: #6b7280;
      margin: 0 0 10px 0;
    }
    .listing-price {
      font-size: 24px;
      font-weight: 700;
      color: #2d5016;
      margin: 10px 0;
    }
    .listing-info {
      display: flex;
      gap: 15px;
      margin: 10px 0;
      font-size: 14px;
      color: #6b7280;
    }
    .match-reason {
      background: #fef3c7;
      border-left: 3px solid #f59e0b;
      padding: 12px;
      margin: 15px 0;
      border-radius: 4px;
      font-size: 14px;
    }
    .match-score {
      display: inline-block;
      background: #2d5016;
      color: white;
      padding: 4px 12px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
    }
    .cta-button {
      display: inline-block;
      background: linear-gradient(135deg, #6b8e23 0%, #556b2f 100%);
      color: white;
      padding: 12px 30px;
      text-decoration: none;
      border-radius: 6px;
      font-weight: 600;
      margin: 10px 0;
    }
    .footer {
      background: #f9fafb;
      padding: 20px;
      text-align: center;
      font-size: 12px;
      color: #6b7280;
      border-top: 1px solid #e5e7eb;
    }
    .footer a {
      color: #2d5016;
      text-decoration: none;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>🏡 Your Personalized Recommendations</h1>
    </div>
    
    <div class="content">
      <p class="greeting">Hi <%= @user.username %>,</p>
      
      <p>Based on your bookmarked listings, we've found <%= @recommendations.count %> properties that we think you'll love!</p>
      
      <div class="summary">
        <strong>Your Profile:</strong> <%= @summary %>
      </div>
      
      <% @recommendations.each do |rec| %>
        <% listing = rec[:listing] %>
        <div class="listing-card">
          <% if listing.image_url.present? %>
            <%= image_tag listing.image_url, alt: listing.title, class: "listing-image" %>
          <% end %>
          
          <div class="listing-details">
            <div style="display: flex; justify-content: space-between; align-items: start;">
              <h2 class="listing-title"><%= listing.title %></h2>
              <span class="match-score"><%= rec[:match_score] %>% Match</span>
            </div>
            
            <p class="listing-location">
              📍 <%= listing.address %>, <%= listing.city %>, <%= listing.state %>
            </p>
            
            <p class="listing-price">
              $<%= number_with_delimiter(listing.price) %><span style="font-size: 16px; color: #6b7280;">/month</span>
            </p>
            
            <div class="listing-info">
              <span>🛏️ <%= listing.bedrooms %> bed</span>
              <span>🚿 <%= listing.bathrooms %> bath</span>
              <span>📏 <%= number_with_delimiter(listing.square_feet) %> sq ft</span>
            </div>
            
            <div class="match-reason">
              <strong>Why we picked this:</strong> <%= rec[:reason] %>
            </div>
            
            <%= link_to "View Details", listing_url(listing), class: "cta-button" %>
          </div>
        </div>
      <% end %>
      
      <p style="text-align: center; margin-top: 30px;">
        <%= link_to "Browse All Listings", listings_url, class: "cta-button" %>
      </p>
    </div>
    
    <div class="footer">
      <p>
        You're receiving this because you have recommendation emails enabled.<br>
        <%= link_to "Update your preferences", edit_user_url(@user) %> | 
        <%= link_to "Unsubscribe", edit_user_url(@user) %>
      </p>
    </div>
  </div>
</body>
</html>
