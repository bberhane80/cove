<div class="listing-card">
  <% if listing.image_url.present? %>
    <%= image_tag listing.image_url, alt: listing.title, class: "listing-image" %>
  <% else %>
    <div class="listing-image-placeholder">No Image</div>
  <% end %>
  
  <div class="listing-details">
    <h3><%= listing.title %></h3>
    <p class="address">
      <i class="bi bi-geo-alt"></i>
      <%= listing.address %>, <%= listing.city %>, <%= listing.state %>
    </p>
    
    <div class="listing-info">
      <span class="price"><%= number_to_currency(listing.price) %>/month</span>
      <% if listing.bedrooms.present? %>
        <span><i class="bi bi-door-closed"></i> <%= listing.bedrooms %> bed</span>
      <% end %>
      <% if listing.bathrooms.present? %>
        <span><i class="bi bi-droplet"></i> <%= listing.bathrooms %> bath</span>
      <% end %>
    </div>
    
    <p class="description"><%= truncate(listing.description, length: 100) %></p>
    
    <div class="listing-actions">
      <%= link_to 'View Details', listing, class: 'btn btn-view-details' %>
      <%= render 'shared/bookmark_button', listing: listing, bookmark: defined?(bookmark) ? bookmark : nil, show_bookmark_date: local_assigns[:show_bookmark_date] %>
    </div>
    
    <% if local_assigns[:show_bookmark_date] && defined?(bookmark) %>
      <p class="bookmark-date">
        <i class="bi bi-clock"></i> Bookmarked on <%= bookmark.created_at.strftime("%B %d, %Y") %>
      </p>
    <% end %>
  </div>
</div>
