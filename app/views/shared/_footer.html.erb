<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-brand">
      <h3>🏡 Cove</h3>
      <p>AI-powered home finding</p>
    </div>
    
    <div class="footer-nav">
      <%= link_to "About", about_path %>
      <%= link_to "Browse Listings", listings_path %>
      <% if user_signed_in? %>
        <%= link_to "My Bookmarks", bookmarks_path %>
        <%= link_to "Profile", user_path(current_user) %>
      <% else %>
        <%= link_to "Sign In", new_user_session_path %>
        <%= link_to "Sign Up", new_user_registration_path %>
      <% end %>
    </div>
    
    <div class="footer-bottom">
      <p>&copy; <%= Time.current.year %> Cove. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #1f2937;
    color: white;
    padding: 40px 20px 20px;
    margin-top: 60px;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-brand {
    text-align: center;
    margin-bottom: 30px;
  }

  .footer-brand h3 {
    font-size: 1.5rem;
    margin: 0 0 5px 0;
  }

  .footer-brand p {
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    font-size: 0.95rem;
  }

  .footer-nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 25px;
    margin-bottom: 30px;
    padding-bottom: 25px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-nav a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .footer-nav a:hover {
    color: #a7f3d0;
  }

  .footer-bottom {
    text-align: center;
  }

  .footer-bottom p {
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .footer-nav {
      gap: 15px;
    }

    .footer-nav a {
      font-size: 0.9rem;
    }
  }
</style>
