<div class="search-suggestions">
  <p class="small text-muted mb-2">Try searching for:</p>
  <div class="d-flex gap-2 flex-wrap">
    <%= link_to "2 bedroom under $2000", listings_path(search: "2 bedroom under $2000"), class: "badge bg-light text-dark" %>
    <%= link_to "Downtown loft", listings_path(search: "downtown loft"), class: "badge bg-light text-dark" %>
    <%= link_to "Pet-friendly", listings_path(search: "pet friendly"), class: "badge bg-light text-dark" %>
    <%= link_to "Near transit", listings_path(search: "near transit"), class: "badge bg-light text-dark" %>
    <%= link_to "Family home", listings_path(search: "family home with yard"), class: "badge bg-light text-dark" %>
  </div>
</div>

<style>
  .search-suggestions {
    text-align: center;
    margin: 15px 0;
  }
  
  .search-suggestions .badge {
    padding: 8px 15px;
    font-size: 0.9rem;
    font-weight: 500;
    border: 1px solid #e5e7eb;
    transition: all 0.2s ease;
  }
  
  .search-suggestions .badge:hover {
    background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%) !important;
    border-color: #2d5016;
    color: #1f2937 !important;
    transform: translateY(-2px);
  }
</style>
