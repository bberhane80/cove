<div class="listing-show-container">
  <div class="row">
    <div class="col-lg-8">
      <% if @listing.image_url.present? %>
        <%= image_tag @listing.image_url, alt: @listing.title, class: "listing-hero-image" %>
      <% else %>
        <div class="listing-hero-placeholder">No Image Available</div>
      <% end %>
      
      <div class="listing-content">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <div>
            <h1 class="listing-title"><%= @listing.title %></h1>
            <p class="listing-address">
              <i class="bi bi-geo-alt-fill"></i>
              <%= @listing.address %>, <%= @listing.city %>, <%= @listing.state %>
            </p>
          </div>
          
          <div class="bookmark-action">
            <% if @bookmarked %>
              <% bookmark = current_user.bookmarks.find_by(listing_id: @listing.id) %>
              <%= button_to bookmark_path(bookmark), method: :delete, class: 'btn btn-bookmarked' do %>
                <i class="bi bi-bookmark-star-fill"></i> Bookmarked
              <% end %>
            <% else %>
              <%= button_to bookmarks_path(listing_id: @listing.id), method: :post, class: 'btn btn-bookmark' do %>
                <i class="bi bi-bookmark"></i> Bookmark
              <% end %>
            <% end %>
          </div>
        </div>
        
        <div class="listing-price">
          <%= number_to_currency(@listing.price) %><span class="price-period">/month</span>
        </div>
        
        <div class="listing-features">
          <div class="feature-item">
            <i class="bi bi-door-open"></i>
            <span><%= @listing.bedrooms %> Bedrooms</span>
          </div>
          <div class="feature-item">
            <i class="bi bi-droplet"></i>
            <span><%= @listing.bathrooms %> Bathrooms</span>
          </div>
          <div class="feature-item">
            <i class="bi bi-rulers"></i>
            <span><%= number_with_delimiter(@listing.square_feet) %> sq ft</span>
          </div>
        </div>
        
        <hr>
        
        <h3>Description</h3>
        <p class="listing-description"><%= @listing.description %></p>
      </div>
    </div>
    
    <div class="col-lg-4">
      <div class="contact-card">
        <h4>Interested in this property?</h4>
        <p class="text-muted">Contact us to schedule a viewing</p>
        <button class="btn btn-primary btn-lg w-100 mb-2">
          <i class="bi bi-envelope"></i> Send Message
        </button>
        <button class="btn btn-outline-primary btn-lg w-100">
          <i class="bi bi-telephone"></i> Call Now
        </button>
      </div>
      
      <div class="property-details mt-4">
        <h5>Property Details</h5>
        <ul class="list-unstyled">
          <li><strong>Price:</strong> <%= number_to_currency(@listing.price) %>/month</li>
          <li><strong>Size:</strong> <%= number_with_delimiter(@listing.square_feet) %> sq ft</li>
          <li><strong>Bedrooms:</strong> <%= @listing.bedrooms %></li>
          <li><strong>Bathrooms:</strong> <%= @listing.bathrooms %></li>
          <li><strong>Location:</strong> <%= @listing.city %>, <%= @listing.state %></li>
        </ul>
      </div>
    </div>
  </div>
  
  <div class="mt-4">
    <%= link_to "← Back to Listings", listings_path, class: "btn btn-secondary" %>
  </div>
</div>

<style>
  .listing-show-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
  }
  
  .listing-hero-image {
    width: 100%;
    height: 500px;
    object-fit: cover;
    border-radius: 12px;
    margin-bottom: 30px;
  }
  
  .listing-hero-placeholder {
    width: 100%;
    height: 500px;
    background: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    margin-bottom: 30px;
    color: #999;
    font-size: 1.2rem;
  }
  
  .listing-content {
    background: white;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }
  
  .listing-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 10px;
    color: #1f2937;
  }
  
  .listing-address {
    font-size: 1.1rem;
    color: #6b7280;
    margin-bottom: 20px;
  }
  
  .listing-address i {
    color: #2d5016;
  }
  
  .listing-price {
    font-size: 2.5rem;
    font-weight: 700;
    color: #2d5016;
    margin-bottom: 20px;
  }
  
  .price-period {
    font-size: 1.2rem;
    color: #6b7280;
  }
  
  .listing-features {
    display: flex;
    gap: 30px;
    margin-bottom: 30px;
  }
  
  .feature-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 15px 20px;
    background: #f9fafb;
    border-radius: 8px;
  }
  
  .feature-item i {
    font-size: 1.5rem;
    color: #2d5016;
  }
  
  .listing-description {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #374151;
  }
  
  .btn-bookmark, .btn-bookmarked {
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 600;
    border: none;
  }
  
  .btn-bookmark {
    background: white;
    border: 2px solid #2d5016;
    color: #2d5016;
  }
  
  .btn-bookmark:hover {
    background: #2d5016;
    color: white;
  }
  
  .btn-bookmarked {
    background: #6b8e23;
    color: white;
  }
  
  .contact-card {
    background: white;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    position: sticky;
    top: 100px;
  }
  
  .property-details {
    background: white;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }
  
  .property-details ul li {
    padding: 8px 0;
    border-bottom: 1px solid #e5e7eb;
  }
  
  .property-details ul li:last-child {
    border-bottom: none;
  }
</style>
