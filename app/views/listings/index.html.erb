<%= render 'shared/listing_card_styles' %>

<div class="listings-container">
  <div class="page-header">
    <h1>Find Your Cove</h1>
    <p class="text-muted">Search for your perfect home below</p>
    <!-- Filters (collapsible) -->
    <%= render 'filters' %>
    <!-- Search Bar -->
    <div class="search-box">
      <%= form_with url: listings_path, method: :get, class: "search-form" do |f| %>
        <!-- Preserve filter parameters -->
        <%= hidden_field_tag :city, params[:city] if params[:city].present? %>
        <%= hidden_field_tag :state, params[:state] if params[:state].present? %>
        <%= hidden_field_tag :min_price, params[:min_price] if params[:min_price].present? %>
        <%= hidden_field_tag :max_price, params[:max_price] if params[:max_price].present? %>
        <%= hidden_field_tag :bedrooms, params[:bedrooms] if params[:bedrooms].present? %>
        <%= hidden_field_tag :bathrooms, params[:bathrooms] if params[:bathrooms].present? %>
        <%= hidden_field_tag :min_sqft, params[:min_sqft] if params[:min_sqft].present? %>
        <%= hidden_field_tag :max_sqft, params[:max_sqft] if params[:max_sqft].present? %>
        <div class="input-group input-group-lg">
          <%= f.text_field :q, 
              class: "form-control search-input", 
              placeholder: "What are you looking for? (e.g., 'affordable studio near transit')",
              value: params[:q],
              autocomplete: "off" %>
          <button class="btn btn-primary search-btn" type="submit">
            <i class="bi bi-search"></i> Smart Search
          </button>
        </div>
      <% end %>
    </div>
    <!-- Active Filters Display -->
    <% if params.slice(:city, :state, :min_price, :max_price, :bedrooms, :bathrooms, :min_sqft, :max_sqft, :search, :q).values.any?(&:present?) %>
      <div class="active-filters">
        <span class="active-filters-label">Active filters:</span>
        <% if params[:city].present? %>
          <span class="filter-tag">
            City: <%= params[:city] %>
            <%= link_to listings_path(params.except(:city)), class: "remove-filter" do %>
              <i class="bi bi-x"></i>
            <% end %>
          </span>
        <% end %>
        <% if params[:state].present? %>
          <span class="filter-tag">
            State: <%= params[:state] %>
            <%= link_to listings_path(params.except(:state)), class: "remove-filter" do %>
              <i class="bi bi-x"></i>
            <% end %>
          </span>
        <% end %>
        <% if params[:min_price].present? %>
          <span class="filter-tag">
            Min: <%= number_to_currency(params[:min_price]) %>
            <%= link_to listings_path(params.except(:min_price)), class: "remove-filter" do %>
              <i class="bi bi-x"></i>
            <% end %>
          </span>
        <% end %>
        <% if params[:max_price].present? %>
          <span class="filter-tag">
            Max: <%= number_to_currency(params[:max_price]) %>
            <%= link_to listings_path(params.except(:max_price)), class: "remove-filter" do %>
              <i class="bi bi-x"></i>
            <% end %>
          </span>
        <% end %>
        <% if params[:bedrooms].present? %>
          <span class="filter-tag">
            <%= params[:bedrooms].to_i == 0 ? 'Studio' : "#{params[:bedrooms]}+ beds" %>
            <%= link_to listings_path(params.except(:bedrooms)), class: "remove-filter" do %>
              <i class="bi bi-x"></i>
            <% end %>
          </span>
        <% end %>
        <% if params[:bathrooms].present? %>
          <span class="filter-tag">
            <%= params[:bathrooms] %>+ baths
            <%= link_to listings_path(params.except(:bathrooms)), class: "remove-filter" do %>
              <i class="bi bi-x"></i>
            <% end %>
          </span>
        <% end %>
        <% if params[:search].present? %>
          <span class="filter-tag">
            Search: "<%= params[:search] %>"
            <%= link_to listings_path(params.permit(:city, :state, :min_price, :max_price, :bedrooms, :bathrooms, :min_sqft, :max_sqft, :search).to_h.except(:search)), class: "remove-filter" do %>
              <i class="bi bi-x"></i>
            <% end %>
          </span>
        <% end %>
        <% if params[:q].present? %>
          <span class="filter-tag">
            AI Search: "<%= params[:q] %>"
            <%= link_to listings_path(params.except(:q)), class: "remove-filter" do %>
              <i class="bi bi-x"></i>
            <% end %>
          </span>
        <% end %>
        <%= link_to "Clear all filters", listings_path, class: "clear-all-btn" %>
      </div>
    <% end %>
    <!-- Results Count -->
    <div class="results-summary">
      <% listings_count = @listings.size %>
      <p>
        <strong><%= listings_count %></strong> <%= 'listing'.pluralize(listings_count) %> found
      </p>
    </div>
    <% if params[:q].present? %>
      <div class="search-results-info">
        <div class="alert alert-info d-flex align-items-center">
          <i class="bi bi-lightbulb me-2"></i>
          <div>
            <strong>AI Search Results:</strong> <%= @search_explanation %>
            <%= link_to "Clear search", listings_path, class: "ms-3 btn btn-sm btn-outline-secondary" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Listings Grid -->
  <% if @listings.any? %>
    <div class="listings-grid">
      <% @listings.each do |listing| %>
        <div class="listing-card">
          <% if listing.image_url.present? %>
            <%= image_tag listing.image_url, alt: listing.title, class: "listing-image" %>
          <% else %>
            <div class="listing-image-placeholder">No Image</div>
          <% end %>
          <div class="listing-details">
            <h3><%= listing.title %></h3>
            <p class="address">
              <i class="bi bi-geo-alt"></i>
              <%= listing.address %>, <%= listing.city %>, <%= listing.state %>
            </p>
            <div class="listing-info">
              <span class="price"><%= number_to_currency(listing.price) %>/month</span>
              <% if listing.bedrooms.present? %>
                <span><%= listing.bedrooms %> bed</span>
              <% end %>
              <% if listing.bathrooms.present? %>
                <span><%= listing.bathrooms %> bath</span>
              <% end %>
            </div>
            <p class="description"><%= truncate(listing.description, length: 100) %></p>
            <div class="listing-actions">
              <%= link_to 'View Details', listing, class: 'btn btn-primary' %>
              <% if @bookmarked_listing_ids.include?(listing.id) %>
                <% bookmark = current_user.bookmarks.find_by(listing_id: listing.id) %>
                <%= button_to '⭐ Bookmarked', bookmark_path(bookmark), method: :delete, class: 'btn btn-bookmarked' %>
              <% else %>
                <%= button_to '☆ Bookmark', bookmarks_path(listing_id: listing.id), method: :post, class: 'btn btn-bookmark' %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <i class="bi bi-search" style="font-size: 4rem; color: #ccc;"></i>
      <p>No listings found matching your search.</p>
      <p class="text-muted">Try adjusting your search terms or browse all listings.</p>
      <%= link_to 'View All Listings', listings_path, class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>
