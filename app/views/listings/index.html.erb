<div class="listings-container">
  <div class="search-header">
    <h1>Find Your Perfect Home</h1>
    <p class="text-muted">Use natural language to search - try "2 bedroom in Chicago under $2000" or "pet friendly loft downtown"</p>
    
    <%= form_with url: listings_path, method: :get, class: "search-form" do |f| %>
      <div class="input-group input-group-lg">
        <%= f.text_field :q, 
            class: "form-control search-input", 
            placeholder: "What are you looking for? (e.g., 'affordable studio near transit')",
            value: params[:q],
            autocomplete: "off" %>
        <button class="btn btn-primary search-btn" type="submit">
          <i class="bi bi-search"></i> Smart Search
        </button>
      </div>
    <% end %>
    
    <% if params[:q].present? %>
      <div class="search-results-info">
        <div class="alert alert-info d-flex align-items-center">
          <i class="bi bi-lightbulb me-2"></i>
          <div>
            <strong>AI Search Results:</strong> <%= @search_explanation %>
            <%= link_to "Clear search", listings_path, class: "ms-3 btn btn-sm btn-outline-secondary" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  
  <% if @listings.any? %>
    <div class="listings-grid">
      <% @listings.each do |listing| %>
        <div class="listing-card">
          <% if listing.image_url.present? %>
            <%= image_tag listing.image_url, alt: listing.title, class: "listing-image" %>
          <% else %>
            <div class="listing-image-placeholder">No Image</div>
          <% end %>
          
          <div class="listing-details">
            <h3><%= listing.title %></h3>
            <p class="address">
              <i class="bi bi-geo-alt"></i>
              <%= listing.address %>, <%= listing.city %>, <%= listing.state %>
            </p>
            
            <div class="listing-info">
              <span class="price"><%= number_to_currency(listing.price) %>/month</span>
              <% if listing.bedrooms.present? %>
                <span><%= listing.bedrooms %> bed</span>
              <% end %>
              <% if listing.bathrooms.present? %>
                <span><%= listing.bathrooms %> bath</span>
              <% end %>
            </div>
            
            <p class="description"><%= truncate(listing.description, length: 100) %></p>
            
            <div class="listing-actions">
              <%= link_to 'View Details', listing, class: 'btn btn-primary' %>
              
              <% if @bookmarked_listing_ids.include?(listing.id) %>
                <% bookmark = current_user.bookmarks.find_by(listing_id: listing.id) %>
                <%= button_to '⭐ Bookmarked', bookmark_path(bookmark), method: :delete, class: 'btn btn-bookmarked' %>
              <% else %>
                <%= button_to '☆ Bookmark', bookmarks_path(listing_id: listing.id), method: :post, class: 'btn btn-bookmark' %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <i class="bi bi-search" style="font-size: 4rem; color: #ccc;"></i>
      <p>No listings found matching your search.</p>
      <p class="text-muted">Try adjusting your search terms or browse all listings.</p>
      <%= link_to 'View All Listings', listings_path, class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>

<style>
  .search-header {
    text-align: center;
    margin-bottom: 40px;
  }
  
  .search-header h1 {
    margin-bottom: 10px;
  }
  
  .search-form {
    max-width: 800px;
    margin: 30px auto;
  }
  
  .search-input {
    border-radius: 50px 0 0 50px;
    padding: 15px 25px;
    border: 2px solid #2d5016;
  }
  
  .search-input:focus {
    border-color: #2d5016;
    box-shadow: 0 0 0 0.2rem rgba(45, 80, 22, 0.25);
  }
  
  .search-btn {
    border-radius: 0 50px 50px 0;
    padding: 15px 30px;
    background: linear-gradient(135deg, #6b8e23 0%, #556b2f 100%);
    border: none;
    font-weight: 600;
  }
  
  .search-btn:hover {
    background: linear-gradient(135deg, #7aa82c 0%, #6b8e23 100%);
  }
  
  .search-results-info {
    max-width: 800px;
    margin: 20px auto;
  }
  
  .listings-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
  }
  
  .listings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }
  
  .listing-card {
    border: 1px solid #ddd;
    border-radius: 8px;
    overflow: hidden;
    transition: box-shadow 0.3s;
  }
  
  .listing-card:hover {
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  }
  
  .listing-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }
  
  .listing-image-placeholder {
    width: 100%;
    height: 200px;
    background-color: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
  }
  
  .listing-details {
    padding: 15px;
  }
  
  .listing-details h3 {
    margin: 0 0 10px 0;
    font-size: 1.2em;
  }
  
  .address {
    color: #666;
    margin: 0 0 10px 0;
  }
  
  .listing-info {
    display: flex;
    gap: 15px;
    margin: 10px 0;
    font-size: 0.9em;
  }
  
  .price {
    font-weight: bold;
    color: #2c5282;
  }
  
  .description {
    color: #555;
    margin: 10px 0;
  }
  
  .listing-actions {
    display: flex;
    gap: 10px;
    margin-top: 15px;
  }
  
  .btn {
    padding: 8px 16px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    font-size: 0.9em;
  }
  
  .btn-primary {
    background-color: #3182ce;
    color: white;
  }
  
  .btn-primary:hover {
    background-color: #2c5282;
  }
  
  .btn-bookmark {
    background-color: #f7fafc;
    border: 1px solid #cbd5e0;
    color: #2d3748;
  }
  
  .btn-bookmark:hover {
    background-color: #edf2f7;
  }
  
  .btn-bookmarked {
    background-color: #fef5e7;
    border: 1px solid #f9d71c;
    color: #744210;
  }
  
  .empty-state {
    text-align: center;
    padding: 60px 20px;
  }
  
  .empty-state p {
    font-size: 1.1em;
    margin: 10px 0;
  }
</style>
