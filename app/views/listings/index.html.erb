<%= render 'shared/listing_card_styles' %>

<div class="listings-container">
  <div class="page-header">
    <h1>Find your cove</h1>
    
    <!-- Filters (collapsible) -->
    <%= render 'filters' %>
    
    <!-- Search Bar -->
    <div class="search-box">
      <%= form_with url: listings_path, method: :get, class: "search-form" do |f| %>
        <!-- Preserve filter parameters -->
        <%= hidden_field_tag :city, params[:city] if params[:city].present? %>
        <%= hidden_field_tag :state, params[:state] if params[:state].present? %>
        <%= hidden_field_tag :min_price, params[:min_price] if params[:min_price].present? %>
        <%= hidden_field_tag :max_price, params[:max_price] if params[:max_price].present? %>
        <%= hidden_field_tag :bedrooms, params[:bedrooms] if params[:bedrooms].present? %>
        <%= hidden_field_tag :bathrooms, params[:bathrooms] if params[:bathrooms].present? %>
        <%= hidden_field_tag :min_sqft, params[:min_sqft] if params[:min_sqft].present? %>
        <%= hidden_field_tag :max_sqft, params[:max_sqft] if params[:max_sqft].present? %>
        
        <div class="input-group">
          <%= f.text_field :search, 
              class: "form-control search-input", 
              placeholder: "Search by location, title, or description...",
              value: params[:search] %>
          <button class="btn btn-search" type="submit">
            <i class="bi bi-search"></i> Search
          </button>
        </div>
      <% end %>
    </div>
    
    <!-- Active Filters Display -->
   <% if params.slice(:city, :state, :min_price, :max_price, :bedrooms, :bathrooms, :min_sqft, :max_sqft, :search).values.any?(&:present?) %>
      <div class="active-filters">
        <span class="active-filters-label">Active filters:</span>
        
        <% if params[:city].present? %>
          <span class="filter-tag">
            City: <%= params[:city] %>
            <%= link_to listings_path(
  city: params[:city],
  state: params[:state],
  min_price: params[:min_price],
  max_price: params[:max_price],
  bedrooms: params[:bedrooms],
  bathrooms: params[:bathrooms],
  min_sqft: params[:min_sqft],
  max_sqft: params[:max_sqft]
), class: "remove-filter" do %>
  <i class="bi bi-x"></i>
<% end %>
          </span>
        <% end %>
        
        <% if params[:state].present? %>
          <span class="filter-tag">
            State: <%= params[:state] %>
            <%= link_to listings_path(
  city: params[:city],
  state: params[:state],
  min_price: params[:min_price],
  max_price: params[:max_price],
  bedrooms: params[:bedrooms],
  bathrooms: params[:bathrooms],
  min_sqft: params[:min_sqft],
  max_sqft: params[:max_sqft]
), class: "remove-filter" do %>
  <i class="bi bi-x"></i>
<% end %>
          </span>
        <% end %>
        
        <% if params[:min_price].present? %>
          <span class="filter-tag">
            Min: <%= number_to_currency(params[:min_price]) %>
            <%= link_to listings_path(
  city: params[:city],
  state: params[:state],
  min_price: params[:min_price],
  max_price: params[:max_price],
  bedrooms: params[:bedrooms],
  bathrooms: params[:bathrooms],
  min_sqft: params[:min_sqft],
  max_sqft: params[:max_sqft]
), class: "remove-filter" do %>
  <i class="bi bi-x"></i>
<% end %>
          </span>
        <% end %>
        
        <% if params[:max_price].present? %>
          <span class="filter-tag">
            Max: <%= number_to_currency(params[:max_price]) %>
            <%= link_to listings_path(
  city: params[:city],
  state: params[:state],
  min_price: params[:min_price],
  max_price: params[:max_price],
  bedrooms: params[:bedrooms],
  bathrooms: params[:bathrooms],
  min_sqft: params[:min_sqft],
  max_sqft: params[:max_sqft]
), class: "remove-filter" do %>
  <i class="bi bi-x"></i>
<% end %>
          </span>
        <% end %>
        
        <% if params[:bedrooms].present? %>
          <span class="filter-tag">
            <%= params[:bedrooms].to_i == 0 ? 'Studio' : "#{params[:bedrooms]}+ beds" %>
            <%= link_to listings_path(
  city: params[:city],
  state: params[:state],
  min_price: params[:min_price],
  max_price: params[:max_price],
  bedrooms: params[:bedrooms],
  bathrooms: params[:bathrooms],
  min_sqft: params[:min_sqft],
  max_sqft: params[:max_sqft]
), class: "remove-filter" do %>
  <i class="bi bi-x"></i>
<% end %>
          </span>
        <% end %>
        
        <% if params[:bathrooms].present? %>
          <span class="filter-tag">
            <%= params[:bathrooms] %>+ baths
            <%= link_to listings_path(
  city: params[:city],
  state: params[:state],
  min_price: params[:min_price],
  max_price: params[:max_price],
  bedrooms: params[:bedrooms],
  bathrooms: params[:bathrooms],
  min_sqft: params[:min_sqft],
  max_sqft: params[:max_sqft]
), class: "remove-filter" do %>
  <i class="bi bi-x"></i>
<% end %>
          </span>
        <% end %>
        
        <% if params[:search].present? %>
          <span class="filter-tag">
            Search: "<%= params[:search] %>"
            <%= link_to listings_path(
  city: params[:city],
  state: params[:state],
  min_price: params[:min_price],
  max_price: params[:max_price],
  bedrooms: params[:bedrooms],
  bathrooms: params[:bathrooms],
  min_sqft: params[:min_sqft],
  max_sqft: params[:max_sqft]
), class: "remove-filter" do %>
  <i class="bi bi-x"></i>
<% end %>
          </span>
        <% end %>
        
        <%= link_to "Clear all filters", listings_path, class: "clear-all-btn" %>
      </div>
    <% end %>
    
    <!-- Results Count and AI Explanation -->
    <div class="results-summary">
      <p>
        <strong><%= @listings.count %></strong> <%= 'listing'.pluralize(@listings.count) %> found
      </p>
      <% if @ai_explanation.present? %>
        <div class="ai-explanation alert alert-info mt-2">
          <%= @ai_explanation %>
        </div>
      <% end %>
    </div>
  </div>
  
  <!-- Listings Grid -->
  <% if @listings.any? %>
    <div class="listings-grid">
      <% @listings.each do |listing| %>
        <%= render 'shared/listing_card', listing: listing, bookmarked_ids: @bookmarked_listing_ids %>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <i class="bi bi-search" style="font-size: 4rem; color: #ccc;"></i>
      <p>No listings found matching your criteria.</p>
      <p class="text-muted">Try adjusting your filters or search terms.</p>
      <%= link_to 'View All Listings', listings_path, class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>

<style>
  .listings-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
  }
  
  .page-header {
    margin-bottom: 30px;
  }
  
  .page-header h1 {
    color: #1f2937;
    margin-bottom: 20px;
  }
  
  .search-box {
    margin: 20px 0;
  }
  
  .search-form {
    max-width: 100%;
  }
  
  .input-group {
    display: flex;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    border-radius: 50px;
    overflow: hidden;
  }
  
  .search-input {
    border: none;
    padding: 15px 25px;
    font-size: 1rem;
    flex: 1;
  }
  
  .search-input:focus {
    outline: none;
    box-shadow: none;
  }
  
  .btn-search {
    background: linear-gradient(135deg, #6b8e23 0%, #556b2f 100%);
    color: white;
    border: none;
    padding: 15px 30px;
    font-weight: 600;
    cursor: pointer;
  }
  
  .btn-search:hover {
    background: linear-gradient(135deg, #7aa82c 0%, #6b8e23 100%);
  }
  
  .active-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    margin: 15px 0;
    padding: 15px;
    background: #f9fafb;
    border-radius: 8px;
  }
  
  .active-filters-label {
    font-weight: 600;
    color: #6b7280;
    font-size: 0.9rem;
  }
  
  .filter-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 20px;
    font-size: 0.9rem;
    color: #374151;
  }
  
  .remove-filter {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    background: #ef4444;
    color: white;
    border-radius: 50%;
    text-decoration: none;
    font-size: 0.7rem;
    transition: all 0.2s ease;
  }
  
  .remove-filter:hover {
    background: #dc2626;
    transform: scale(1.1);
  }
  
  .clear-all-btn {
    padding: 6px 12px;
    background: #ef4444;
    color: white;
    border-radius: 20px;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }
  
  .clear-all-btn:hover {
    background: #dc2626;
  }
  
  .results-summary {
    margin: 15px 0;
    padding: 10px 0;
    border-bottom: 2px solid #e5e7eb;
  }
  
  .results-summary p {
    margin: 0;
    color: #6b7280;
  }
  
  .empty-state {
    text-align: center;
    padding: 60px 20px;
  }
  
  .empty-state p {
    font-size: 1.1em;
    margin: 10px 0;
  }
</style>
