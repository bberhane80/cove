<style>
  .listings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }
  .listing-card {
    border: 1px solid #ddd;
    border-radius: 8px;
    overflow: hidden;
    transition: box-shadow 0.3s;
    background: white;
  }
  .listing-card:hover {
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  }
  .listing-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }
  .listing-image-placeholder {
    width: 100%;
    height: 200px;
    background-color: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
  }
  .listing-details {
    padding: 15px;
  }
  .listing-details h3 {
    margin: 0 0 10px 0;
    font-size: 1.2em;
    color: #1f2937;
  }
  .address {
    color: #666;
    margin: 0 0 10px 0;
    font-size: 0.95em;
  }
  .listing-info {
    display: flex;
    gap: 15px;
    margin: 10px 0;
    font-size: 0.9em;
  }
  .price {
    font-weight: bold;
    color: #2c5282;
  }
  .description {
    color: #555;
    margin: 10px 0;
    line-height: 1.5;
  }
  .listing-actions {
    display: flex;
    gap: 10px;
    margin-top: 15px;
  }
  .btn {
    padding: 8px 16px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    font-size: 0.9em;
    transition: all 0.2s ease;
  }
  .btn-primary {
    background-color: #3182ce;
    color: white;
  }
  .btn-primary:hover {
    background-color: #2c5282;
    transform: translateY(-1px);
  }
  .btn-view-details {
    background-color: #3a6925;
    color: #ffffff;
    border: 1px solid #2d4d16;
  }
  .btn-view-details:hover {
    background-color: #2d4d16;
    color: #ffffff;
    transform: translateY(-1px);
  }
  .search-btn {
    min-width: 140px;
  }
  .btn-remove {
    background-color: #fc8181;
    color: white;
  }
  .btn-remove:hover {
    background-color: #f56565;
  }
  .btn-bookmark {
    background-color: #f7fafc;
    border: 1px solid #cbd5e0;
    color: #2d3748;
  }
  .btn-bookmark:hover {
    background-color: #edf2f7;
  }
  .btn-bookmarked {
    background-color: #fef5e7;
    border: 1px solid #f9d71c;
    color: #744210;
  }
  .bookmark-date {
    font-size: 0.85em;
    color: #999;
    margin-top: 10px;
    font-style: italic;
  }
  .empty-state {
    text-align: center;
    padding: 60px 20px;
  }
  .empty-state p {
    font-size: 1.2em;
    color: #666;
    margin-bottom: 20px;
  }
</style>

<div class="listings-container">
  <div class="page-header">
  <h1>Find Your Cove</h1>
  <p class="text-muted">Search for your perfect home below</p>
  <!-- Filters (collapsible) -->
  <%= render 'filters' %>
    <!-- Search Bar -->
    <div class="search-box">
      <%= form_with url: listings_path, method: :get, class: "search-form" do |f| %>
        <!-- Preserve filter parameters -->
        <%= hidden_field_tag :city, params[:city] if params[:city].present? %>
        <%= hidden_field_tag :state, params[:state] if params[:state].present? %>
        <%= hidden_field_tag :min_price, params[:min_price] if params[:min_price].present? %>
        <%= hidden_field_tag :max_price, params[:max_price] if params[:max_price].present? %>
        <%= hidden_field_tag :bedrooms, params[:bedrooms] if params[:bedrooms].present? %>
        <%= hidden_field_tag :bathrooms, params[:bathrooms] if params[:bathrooms].present? %>
        <%= hidden_field_tag :min_sqft, params[:min_sqft] if params[:min_sqft].present? %>
        <%= hidden_field_tag :max_sqft, params[:max_sqft] if params[:max_sqft].present? %>
        <div class="input-group input-group-lg">
          <%= f.text_field :q, 
              class: "form-control search-input", 
              placeholder: "What are you looking for? (e.g., 'affordable studio near transit')",
              value: params[:q],
              autocomplete: "off" %>
          <button class="btn btn-view-details search-btn" type="submit">
            <i class="bi bi-search"></i> Search
          </button>
        </div>
      <% end %>
    </div>
    <!-- Active Filters Display -->
    <% if params.slice(:city, :state, :min_price, :max_price, :bedrooms, :bathrooms, :min_sqft, :max_sqft, :search, :q).values.any?(&:present?) %>
      <div class="active-filters">
        <span class="active-filters-label">Filters:</span>
        <% [
          [:city, 'City'],
          [:state, 'State'],
          [:min_price, 'Min'],
          [:max_price, 'Max'],
          [:bedrooms, 'Beds'],
          [:bathrooms, 'Baths'],
          [:search, 'Search'],
          [:q, 'AI Search']
        ].each do |key, label| %>
          <% if params[key].present? %>
            <span class="filter-tag">
              <%= label %>: <%= key == :min_price || key == :max_price ? number_to_currency(params[key]) : params[key] %>
              <%= link_to listings_path(params.to_unsafe_h.except(key)), class: "remove-filter" do %>
                <i class="bi bi-x"></i>
              <% end %>
            </span>
          <% end %>
        <% end %>
        <%= link_to "Clear all filters", listings_path, class: "clear-all-btn" %>
      </div>
    <% end %>
    
    <!-- Results Count and AI Explanation -->
    <div class="results-summary">
      
      <% if @ai_explanation.present? %>
        <div class="ai-explanation alert alert-info mt-2">
          <%= @ai_explanation %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Listings Grid -->
  <% if @listings.any? %>
    <div class="listings-grid">
      <% @listings.each do |listing| %>
        <div class="listing-card">
          <% if listing.image_url.present? %>
            <%= image_tag listing.image_url, alt: listing.title, class: "listing-image" %>
          <% else %>
            <div class="listing-image-placeholder">No Image</div>
          <% end %>
          <div class="listing-details">
            <h3><%= listing.title %></h3>
            <p class="address">
              <i class="bi bi-geo-alt"></i>
              <%= listing.address %>, <%= listing.city %>, <%= listing.state %>
            </p>
            <div class="listing-info">
              <span class="price"><%= number_to_currency(listing.price) %>/month</span>
              <% if listing.bedrooms.present? %>
                <span><%= listing.bedrooms %> bed</span>
              <% end %>
              <% if listing.bathrooms.present? %>
                <span><%= listing.bathrooms %> bath</span>
              <% end %>
            </div>
            <p class="description"><%= truncate(listing.description, length: 100) %></p>
            <div class="listing-actions">
              <%= link_to 'View Details', listing, class: 'btn btn-view-details' %>
              <%= render 'shared/bookmark_button', listing: listing %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <i class="bi bi-search" style="font-size: 4rem; color: #ccc;"></i>
      <p>No listings found matching your search.</p>
      <p class="text-muted">Try adjusting your search terms or browse all listings.</p>
      <%= link_to 'View All Listings', listings_path, class: 'btn btn-primary' %>
    </div>
  <% end %>
