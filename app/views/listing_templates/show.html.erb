<h1>
  Listing #<%= @the_listing.id %> details
</h1>

<article>
  <div>
    <a href="/listings">
      Go back
    </a>
  </div>

  <div>
    <a href="/delete_listing/<%= @the_listing.id %>">
      Delete listing
    </a>
  </div>
  <dl>
    <dt>
      User
    </dt>
    <dd>
      <%= @the_listing.user_id %>
    </dd>

    <dt>
      Address
    </dt>
    <dd>
      <%= @the_listing.address %>
    </dd>

    <dt>
      Details
    </dt>
    <dd>
      <%= @the_listing.details %>
    </dd>

    <dt>
      Neighborhood
    </dt>
    <dd>
      <%= @the_listing.neighborhood %>
    </dd>

    <dt>
      City
    </dt>
    <dd>
      <%= @the_listing.city %>
    </dd>

    <dt>
      State
    </dt>
    <dd>
      <%= @the_listing.state %>
    </dd>

    <dt>
      Created at
    </dt>
    <dd>
      <%= time_ago_in_words(@the_listing.created_at) %> ago
    </dd>

    <dt>
      Updated at
    </dt>
    <dd>
      <%= time_ago_in_words(@the_listing.updated_at) %> ago
    </dd>
  </dl>
</article>

<hr>


<article>
  <header>
    <h2>
      Edit listing
    </h2>
  </header>

  <form action="/modify_listing/<%= @the_listing.id %>"  method="post" >
    <div>
      <label for="user_id_box">
        User
      </label>

      <input type="text" id="user_id_box" name="query_user_id" value="<%= @the_listing.user_id %>">
    </div>

    <div>
      <label for="address_box">
        Address
      </label>

      <input type="text" id="address_box" name="query_address" value="<%= @the_listing.address %>">
    </div>

    <div>
      <label for="details_box">
        Details
      </label>

      <input type="text" id="details_box" name="query_details" value="<%= @the_listing.details %>">
    </div>

    <div>
      <label for="neighborhood_box">
        Neighborhood
      </label>

      <input type="text" id="neighborhood_box" name="query_neighborhood" value="<%= @the_listing.neighborhood %>">
    </div>

    <div>
      <label for="city_box">
        City
      </label>

      <input type="text" id="city_box" name="query_city" value="<%= @the_listing.city %>">
    </div>

    <div>
      <label for="state_box">
        State
      </label>

      <input type="text" id="state_box" name="query_state" value="<%= @the_listing.state %>">
    </div>

    <button type="submit">
      Update listing
    </button>
  </form>
</article>

<hr>
