    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.3rem;
  }

  .testimonial-author strong {
    display: block;
    color: #1f2937;
  }

  .testimonial-author span {
    display: block;
    color: #6b7280;
    font-size: 0.9rem;
  }

  /* Final CTA */
  .final-cta-section {
    padding: 80px 20px;
    background: linear-gradient(135deg, #2d5016 0%, #1b3409 100%);
  }

  .cta-box {
    max-width: 800px;
