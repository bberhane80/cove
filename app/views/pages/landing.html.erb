  .cta-footnote {
    margin-top: 20px;
    font-size: 1rem;
    opacity: 0.9;
  }

  .cta-footnote a {
    color: #a7f3d0;
    text-decoration: underline;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero-section {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-content {
      max-width: 100%;
