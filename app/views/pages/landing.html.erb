<div class="landing-page">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-content">
      <h1 class="hero-title">Find Your Perfect Home with Cove</h1>
      <p class="hero-subtitle">
        Stop scrolling through endless listings. Let Cove's intelligent recommendations 
        find properties that match your unique style, budget, and lifestyle.
      </p>
      
      <div class="hero-cta">
        <%= link_to listings_path, class: "btn btn-hero-primary" do %>
          Browse Listings
          <i class="bi bi-arrow-right ms-2"></i>
        <% end %>
        <%= link_to about_path, class: "btn btn-hero-secondary" do %>
          Learn More
        <% end %>
      </div>
      
      <p class="hero-trust">Join the Cove community today!</p>
    </div>
    
    <div class="hero-visual">
      <div class="hero-card card-1">
        <div class="card-icon">🏡</div>
        <div class="card-text">Modern Downtown Loft</div>
        <div class="card-badge">95% Match</div>
      </div>
      <div class="hero-card card-2">
        <div class="card-icon">✨</div>
        <div class="card-text">AI-Powered</div>
      </div>
      <div class="hero-card card-3">
        <div class="card-icon">💚</div>
        <div class="card-text">Perfect for You</div>
      </div>
    </div>
  </section>

  <!-- Problem Section -->
  <section class="problem-section">
    <div class="container">
      <h2>Apartment Hunting Shouldn't Be This Hard</h2>
      <div class="problems-grid">
        <div class="problem-card">
          <div class="problem-icon">😫</div>
          <h3>Overwhelming Choices</h3>
          <p>Hundreds of listings, but which ones are actually right for you?</p>
        </div>
        
        <div class="problem-card">
          <div class="problem-icon">⏰</div>
          <h3>Wasted Time</h3>
          <p>Hours spent scrolling through irrelevant properties</p>
        </div>
        
        <div class="problem-card">
          <div class="problem-icon">🤷</div>
          <h3>Generic Results</h3>
          <p>Filters can't capture what makes a home feel like yours</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution Section -->
  <section class="solution-section">
    <div class="container">
      <div class="solution-content">
        <div class="solution-text">
          <span class="solution-label">The Cove Difference</span>
          <h2>AI That Actually Understands You</h2>
          <p>
            Cove learns what you love by analyzing your bookmarked properties. Our AI considers 
            everything—from architectural style and neighborhood vibe to price range and amenities—to 
            deliver recommendations tailored specifically to your taste.
          </p>
          
          <ul class="solution-benefits">
            <li>
              <i class="bi bi-check-circle-fill"></i>
              <span><strong>Truly Personal:</strong> Recommendations based on your actual preferences, not just filters</span>
            </li>
            <li>
              <i class="bi bi-check-circle-fill"></i>
              <span><strong>Saves Time:</strong> Skip the irrelevant listings and see only properties you'll love</span>
            </li>
            <li>
              <i class="bi bi-check-circle-fill"></i>
              <span><strong>Gets Smarter:</strong> The more you use Cove, the better your recommendations become</span>
            </li>
            <li>
              <i class="bi bi-check-circle-fill"></i>
              <span><strong>Discover Gems:</strong> Find hidden properties you might have overlooked</span>
            </li>
          </ul>
        </div>
        
        <div class="solution-visual">
          <div class="visual-box">
            <div class="visual-header">
              <i class="bi bi-stars"></i>
              <span>AI Analysis</span>
            </div>
            <div class="visual-items">
              <div class="visual-item">Historic charm ✓</div>
              <div class="visual-item">Walkable neighborhood ✓</div>
              <div class="visual-item">$2,000-$2,500 range ✓</div>
              <div class="visual-item">Natural light ✓</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="how-it-works-section">
    <div class="container">
      <h2>How Cove Works</h2>
      <p class="section-subtitle">Finding your perfect home in three simple steps</p>
      
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-number">1</div>
          <div class="step-icon">🔍</div>
          <h3>Browse & Bookmark</h3>
          <p>Explore listings and bookmark the ones that catch your eye. Cove starts learning your preferences immediately.</p>
        </div>
        
        <div class="step-arrow">→</div>
        
        <div class="step-card">
          <div class="step-number">2</div>
          <div class="step-icon">🤖</div>
          <h3>AI Learns Your Style</h3>
          <p>Our AI analyzes patterns in what you like—location, style, amenities, price—to understand your unique taste.</p>
        </div>
        
        <div class="step-arrow">→</div>
        
        <div class="step-card">
          <div class="step-number">3</div>
          <div class="step-icon">💌</div>
          <h3>Get Personalized Recommendations</h3>
          <p>Receive tailored suggestions with explanations of why each property is perfect for you.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Social Proof -->
  <section class="testimonials-section">
    <div class="container">
      <h2>What People Are Saying</h2>
      
      <div class="testimonials-grid">
        <div class="testimonial-card">
          <div class="stars">⭐⭐⭐⭐⭐</div>
          <p class="testimonial-text">
            "Cove understood my style better than I did! It recommended a Victorian apartment 
            I would have never searched for, and it's perfect."
          </p>
          <div class="testimonial-author">
            <div class="author-avatar">S</div>
            <div>
              <strong>Sarah M.</strong>
              <span>Found home in 2 weeks</span>
            </div>
          </div>
        </div>
        
        <div class="testimonial-card">
          <div class="stars">⭐⭐⭐⭐⭐</div>
          <p class="testimonial-text">
            "I was spending hours every day looking at apartments. Cove saved me so much time 
            by showing me only properties that actually matched what I wanted."
          </p>
          <div class="testimonial-author">
            <div class="author-avatar">M</div>
            <div>
              <strong>Mike L.</strong>
              <span>Software Engineer</span>
            </div>
          </div>
        </div>
        
        <div class="testimonial-card">
          <div class="stars">⭐⭐⭐⭐⭐</div>
          <p class="testimonial-text">
            "The AI explanations are incredible. It told me why each place was a good fit, 
            which helped me make confident decisions."
          </p>
          <div class="testimonial-author">
            <div class="author-avatar">J</div>
            <div>
              <strong>Jessica P.</strong>
              <span>Recent graduate</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta-section">
    <div class="cta-box">
      <h2>Ready to Find Your Perfect Home?</h2>
      <p>Join Cove today and let us do the heavy lifting.</p>
      
      <%= link_to listings_path, class: "btn btn-cta-large" do %>
        <i class="bi bi-house-heart-fill me-2"></i>
        Browse listings
        <i class="bi bi-arrow-right ms-2"></i>
      <% end %>
    </div>
  </section>
</div>

<style>
  .landing-page {
    margin: 0;
    padding: 0;
