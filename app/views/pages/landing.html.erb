  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.5rem;
    }

    .hero-subtitle {
      font-size: 1.1rem;
    }

    .cta-box h2 {
      font-size: 2rem;
    }

    .btn-cta-large {
      font-size: 1.1rem;
      padding: 16px 35px;
    }
  }
</style>
