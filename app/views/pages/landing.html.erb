    max-width: 600px;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 25px;
  }

  .hero-subtitle {
    font-size: 1.3rem;
    line-height: 1.6;
    opacity: 0.95;
    margin-bottom: 35px;
  }

  .hero-cta {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
    margin-bottom: 25px;
  }

  .btn-hero-primary {
    background: linear-gradient(135deg, #a7f3d0 0%, #6ee7b7 100%);
