<%= render 'shared/profile_stats_styles' %>

<div class="profile-container">
  <h1><%= @user.name %></h1>
  <%= render 'shared/profile_stats_display', user: @user %>
  <% if @user == current_user %>
    <%= link_to 'Edit Profile', edit_user_path(@user), class: 'btn btn-primary' %>
  <% end %>
  <hr>
  <h2>Bookmarked Listings (<%= @bookmarks.count %>)</h2>
  <% if @bookmarks.any? %>
    <div class="listings-grid">
      <% @bookmarks.each do |bookmark| %>
        <% listing = bookmark.listing %>
        <div class="listing-card">
          <% if listing.image_url.present? %>
            <%= image_tag listing.image_url, alt: listing.title, class: "listing-image" %>
          <% else %>
            <div class="listing-image-placeholder">No Image</div>
          <% end %>
          <div class="listing-details">
            <h3><%= listing.title %></h3>
            <p class="address"><%= listing.address %></p>
            <div class="listing-info">
              <span class="price"><%= number_to_currency(listing.price) %>/month</span>
              <% if listing.bedrooms.present? %>
                <span><%= listing.bedrooms %> bed</span>
              <% end %>
              <% if listing.bathrooms.present? %>
                <span><%= listing.bathrooms %> bath</span>
              <% end %>
            </div>
            <div class="listing-actions" style="display: flex; gap: 10px;">
              <%= link_to 'View Details', listing, class: 'btn btn-primary' %>
              <%= button_to 'Remove', bookmark_path(bookmark), method: :delete, data: { confirm: 'Are you sure you want to remove this bookmark?' }, class: 'btn btn-remove' %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>No bookmarked listings yet. <%= link_to 'Browse listings', listings_path %> to get started!</p>
  <% end %>
</div>

<style>
  .profile-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
  }
  
  .profile-info {
    background: #f7fafc;
    padding: 20px;
    border-radius: 8px;
    margin: 20px 0;
  }
  
  .listings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }
  
  .listing-card {
    border: 1px solid #ddd;
    border-radius: 8px;
    overflow: hidden;
  }
  
  .listing-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }
  
  .listing-image-placeholder {
    width: 100%;
    height: 200px;
    background-color: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
  }
  
  .listing-details {
    padding: 15px;
  }
  
  .listing-details h3 {
    margin: 0 0 10px 0;
    font-size: 1.2em;
  }
  
  .address {
    color: #666;
    margin: 0 0 10px 0;
  }
  
  .listing-info {
    display: flex;
    gap: 15px;
    margin: 10px 0 15px 0;
    font-size: 0.9em;
  }
  
  .price {
    font-weight: bold;
    color: #2c5282;
  }
  
  .btn {
    padding: 8px 16px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    font-size: 0.9em;
    background-color: #3182ce;
    color: white;
  }
  
  .btn:hover {
    background-color: #2c5282;
  }
</style>
